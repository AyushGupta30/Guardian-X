# Copy this file to `.env` (never commit the real `.env`) or, in Colab,
# add these same names under Settings -> Secrets instead.

# Hugging Face token (Settings -> Access Tokens on huggingface.co)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gmail sender address used for ticket notification emails
EMAIL_FROM=you@gmail.com

# Gmail "App Password" (Google Account -> Security -> 2-Step Verification -> App passwords)
# Do NOT use your real Gmail login password here.
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional: webhook endpoint the notebook posts ticket events to
GUARDIANX_WEBHOOK_URL=https://webhook.site/your-unique-url
